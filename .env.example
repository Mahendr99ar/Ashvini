# Copy to .env. Every setting is ASHVINI_<NAME>; see backend/ashvini/config.py for all of them.
ASHVINI_DATA_SOURCE=celestrak          # or synthetic for an offline demo
ASHVINI_SPACEWEATHER_SOURCE=noaa       # or synthetic
ASHVINI_PRIMARY_GROUPS=stations        # CelesTrak groups whose members are screened against everything
ASHVINI_PRIMARY_NORAD_IDS=             # extra objects to screen, comma separated
ASHVINI_SECRET=change-me               # salts API key hashes; set a long random value
ASHVINI_CORS_ORIGINS=http://localhost:5173
ASHVINI_RISK_MODEL_PATH=models/collision-risk.onnx   # trained on ESA data (run 6); empty means current Pc
# Optional: email alerts
ASHVINI_SMTP_HOST=
# Optional: an OpenAI-compatible endpoint for the copilot; without it the offline writer answers
ASHVINI_COPILOT_BASE_URL=
ASHVINI_COPILOT_API_KEY=
ASHVINI_COPILOT_MODEL=
